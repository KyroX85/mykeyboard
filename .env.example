NODE_ENV=production
PUBLIC_BASE_URL=https://your-render-service.onrender.com
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
FOUNDER_WHATSAPP_NUMBER=+15551234567
WHATSAPP_RATE_LIMIT_WINDOW_MS=60000
WHATSAPP_RATE_LIMIT_MAX=12
WHATSAPP_COMMAND_COOLDOWN_MS=3000
WHATSAPP_REPLAY_WINDOW_MS=600000
WHATSAPP_ABUSE_WINDOW_MS=900000
WHATSAPP_ABUSE_MAX=8
ALLOW_UNVERIFIED_WHATSAPP=false
NVIDIA_DEEPSEEK_API_KEY=replace_with_nvidia_deepseek_key
NVIDIA_LLAMA_API_KEY=replace_with_nvidia_llama_key
CTO_AI_EXECUTION_COMMIT=false
CTO_AI_EXECUTION_PUSH=false
