          "risk": "HIGH",
          "allowed_actions": ["proposal_only", "ask_founder"],
          "success_metric": "privacy-safe local-only design approved",
          "product_impact": "learning foundation",
          "status": "LOCKED_UNTIL_PHASE"
        },
        {
