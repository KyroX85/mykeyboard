{
  "version": "1.0",
  "north_star": "By May 2027, Aritenis must have keyboard stability close to Gboard level, basic on-device learning of typing patterns, and a companion chat foundation ready for founder handover.",
  "vision_summary": "Aritenis is an Android keyboard that learns typing rhythm, corrections, backspace patterns, language mixing, and time-of-day shifts on-device only, then uses that private behavioral context to support Indian teenagers through a Tanglish/Hinglish companion inside the keyboard.",
  "planning_horizon": {
    "start": "2026-06-04",
    "end": "2027-05-31"
  },
  "global_rules": [
    "Never break existing keyboard behavior.",
    "Never skip phases.",
    "Founder approves all phase transitions.",
    "Low-risk maintenance can be executed after validation.",
    "Medium-risk changes require a staging branch and founder approval.",
    "High-risk changes require three options and no autonomous execution.",
    "No data may leave device for product telemetry or typing behavior.",
    "Runtime/product evidence beats reports and cosmetic cleanup."
  ],
  "forbidden_autonomous_scopes": [
    "privacy",
    "database",
    "networking",
    "telemetry",
    "authentication",
    "prediction_core",
    "swipe_core",
    "workflow_mutation",
    "dependency_upgrade",
    "gradle_structure",
    "google-services.json"
  ],
  "success_signals": [
    "Android validation passes",
    "health score increases",
    "critical risks decrease",
    "typing confidence improves",
    "swipe reliability improves",
    "crash likelihood decreases",
    "APK growth stays controlled",
    "memory growth stays controlled",
    "real-device user feedback improves"
  ],
  "phases": [
    {
      "id": "phase-1-stabilization",
      "name": "Stabilization",
      "window": "2026-06-04 to 2026-08-31",
      "goal": "Keyboard so stable no user uninstalls because of bugs.",
      "phase_transition_requires_founder": true,
      "exit_criteria": [
        "Health score reaches 85 or higher",
        "All issues in ENGINEERING_REPORT.md are resolved or explicitly accepted",
        "All critical security issues are fixed",
        "Android validation passes",
        "Zero known crash-class blockers",
        "Gboard-level key feel has real-device evidence",
        "500 typing samples collected",
        "10 users minimum"
      ],
      "goals": [
        {
          "id": "stab-001-live-validation",
          "title": "Keep Android validation green",
          "priority": "CRITICAL",
          "owner": "reviewer",
          "risk": "LOW",
          "allowed_actions": ["scan", "validate", "report", "safe_fix"],
          "success_metric": "testDebugUnitTest, assembleDebug, and lintDebug pass",
          "product_impact": "build reliability",
          "status": "ACTIVE"
        },
        {
          "id": "stab-002-critical-risk-burn-down",
          "title": "Burn down critical risks from live brain scans",
          "priority": "CRITICAL",
          "owner": "auditor",
          "risk": "MEDIUM",
          "allowed_actions": ["scan", "classify", "propose_patch", "ask_founder"],
          "success_metric": "critical risk count trends down to zero",
          "product_impact": "crash and security risk reduction",
          "status": "ACTIVE"
        },
        {
          "id": "stab-003-key-feel-evidence",
          "title": "Collect evidence for Gboard-level key feel",
          "priority": "HIGH",
          "owner": "cto",
          "risk": "MEDIUM",
          "allowed_actions": ["diagnose", "measure", "propose_patch", "ask_founder"],
          "success_metric": "typing latency, touch confidence, and correction behavior are measured",
          "product_impact": "typing confidence",
          "status": "ACTIVE"
        },
        {
          "id": "stab-004-safe-cleanup",
          "title": "Execute only validated low-risk cleanup",
          "priority": "MEDIUM",
          "owner": "coder",
          "risk": "LOW",
          "allowed_actions": ["formatting", "documentation_cleanup", "dead_import_cleanup", "stale_report_cleanup"],
          "success_metric": "cleanup lands only after validation and rollback path exists",
          "product_impact": "maintainability without runtime risk",
          "status": "ACTIVE"
        }
      ]
    },
