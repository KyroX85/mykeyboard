# Required
AI_PIPELINE_PROJECT_NAME=MyKeyboard
AI_PIPELINE_REPORT_RECIPIENT=founder@example.com
AI_PIPELINE_SMTP_HOST=smtp.gmail.com
AI_PIPELINE_SMTP_PORT=587
AI_PIPELINE_SMTP_USERNAME=your-email@gmail.com
AI_PIPELINE_SMTP_PASSWORD=app-password-here
AI_PIPELINE_SMTP_FROM=your-email@gmail.com

# Optional
AI_PIPELINE_SMTP_ENABLE_SSL=false
AI_PIPELINE_EMAIL_MAX_RETRIES=3
AI_PIPELINE_EMAIL_RETRY_BACKOFF_SECONDS=5
AI_PIPELINE_EMAIL_MIN_INTERVAL_SECONDS=30
AI_PIPELINE_EMAIL_TIMEOUT_MS=30000
AI_PIPELINE_SEND_ON_STATUS=PASSED
AI_PIPELINE_ENABLE_DISCORD_SUMMARY=true
AI_PIPELINE_ENABLE_TELEGRAM_SUMMARY=true
