<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:foregroundGravity="bottom">

    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:gravity="bottom"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/keyboardPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/keyboard_container_bg"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:clipToOutline="false">

            <LinearLayout
                android:id="@+id/keyboardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="bottom"
                android:orientation="vertical"
                android:paddingLeft="0dp"
                android:paddingTop="0dp"
                android:paddingRight="0dp"
                android:paddingBottom="0dp">

                <LinearLayout
                    android:id="@+id/suggestionBar"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FF171C23"
                    android:gravity="center_vertical"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/numberRow"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp" />

                <LinearLayout
                    android:id="@+id/lettersLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/emojiContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FF0E1117"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#FF161B22"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <EditText
                android:id="@+id/emojiSearchInput"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:background="#FF2A2F38"
                android:hint="Search emojis"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF9EA7B3"
                android:textSize="14sp" />
        </LinearLayout>

        <GridView
            android:id="@+id/emojiPanel"
            android:layout_width="match_parent"
            android:layout_height="244dp"
            android:numColumns="8" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="#FF161B22"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/emojiCategoryBar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingRight="8dp" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/backToKeyboard"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#FF2A2F38"
            android:textColor="#FFFFFFFF"
            android:text="ABC" />
    </LinearLayout>
</FrameLayout>
