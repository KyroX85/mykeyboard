<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:foregroundGravity="bottom">

    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:gravity="bottom"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/keyboardPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/keyboard_container_bg"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:clipToOutline="false">

            <com.example.mykeyboard.KeyboardAmbientBackgroundView
                android:id="@+id/keyboardAmbientBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:clickable="false"
                android:focusable="false" />

            <LinearLayout
                android:id="@+id/keyboardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="bottom"
                android:orientation="vertical"
                android:paddingLeft="0dp"
                android:paddingTop="0dp"
                android:paddingRight="0dp"
                android:paddingBottom="0dp">

                <LinearLayout
                    android:id="@+id/suggestionBar"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FF0B0B0D"
                    android:gravity="center_vertical"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/numberRow"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp" />

                <LinearLayout
                    android:id="@+id/lettersLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:id="@+id/keyboardBottomSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@android:color/transparent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/emojiContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FF0B0B0D"
        android:orientation="vertical"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="#FF111113"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/emojiCategoryBar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingRight="8dp" />
        </HorizontalScrollView>

        <GridView
            android:id="@+id/emojiPanel"
            android:layout_width="match_parent"
            android:layout_height="204dp"
            android:numColumns="9" />

        <Button
            android:id="@+id/backToKeyboard"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="#FF1C1C1E"
            android:textColor="#FFFFFFFF"
            android:text="ABC" />

        <View
            android:id="@+id/emojiBottomSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@android:color/transparent" />
    </LinearLayout>
</FrameLayout>
