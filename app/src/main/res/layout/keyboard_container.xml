<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/suggestionBar"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="#222222"
            android:orientation="horizontal" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/keyboard_container_bg"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/bgImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.72"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_keyboard" />

            <View
                android:id="@+id/darkOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#99000000" />

            <LinearLayout
                android:id="@+id/lettersLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/emojiContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#222222"
        android:orientation="vertical"
        android:visibility="gone">

        <GridView
            android:id="@+id/emojiPanel"
            android:layout_width="match_parent"
            android:layout_height="244dp"
            android:numColumns="8" />

        <Button
            android:id="@+id/backToKeyboard"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="ABC" />
    </LinearLayout>
</FrameLayout>
