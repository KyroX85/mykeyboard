<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="1dp">
                <shape>
                    <solid android:color="#FF3A3A3C" />
                    <stroke
                        android:width="1dp"
                        android:color="#FF4A4A4D" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item android:top="1dp">
                <shape>
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="2dp"
                        android:color="#FF20D6FF" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item android:top="2dp">
                <shape>
                    <solid android:color="#8A000000" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape>
                    <solid android:color="#FF2C2C2E" />
                    <stroke
                        android:width="2dp"
                        android:color="#FF3A3A3C" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape>
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="2dp"
                        android:color="#D020D6FF" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
