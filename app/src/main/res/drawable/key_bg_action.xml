<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="1dp">
                <shape>
                    <solid android:color="#FF4D6570" />
                    <stroke
                        android:width="1dp"
                        android:color="#FF657A84" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item android:top="2dp">
                <shape>
                    <solid android:color="#66000000" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape>
                    <solid android:color="#FF445A65" />
                    <stroke
                        android:width="1dp"
                        android:color="#FF5C707A" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
